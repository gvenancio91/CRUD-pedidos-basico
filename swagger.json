{
  "swagger": "2.0",
  "info": {
    "title": "Order Management API",
    "description": "Simple API to manage orders with complete CRUD operations",
    "version": "1.0.0",
    "contact": {
      "name": "Jitterbit API Support"
    }
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/order": {
      "post": {
        "summary": "Create a new order",
        "description": "Creates a new order in the database with data transformation",
        "operationId": "createOrder",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Order object to be created",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PedidoInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Order created successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "orderId": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Order with this ID already exists"
          },
          "500": {
            "description": "Error creating order"
          }
        }
      }
    },
    "/order/{orderId}": {
      "get": {
        "summary": "Get order data by ID",
        "description": "Returns the data of a specific order",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "Order ID (ex: v10089016vdb)",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Order found",
            "schema": {
              "$ref": "#/definitions/Order"
            }
          },
          "404": {
            "description": "Order not found"
          },
          "500": {
            "description": "Error fetching order"
          }
        }
      },
      "put": {
        "summary": "Update order",
        "description": "Updates the data of an existing order.",
        "operationId": "updateOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "Order ID to be updated",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated order details",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PedidoInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order updated successfully",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "order": {
                  "$ref": "#/definitions/Pedido"
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          },
          "500": {
            "description": "Error updating order"
          }
        }
      },
      "delete": {
        "summary": "Delete an order",
        "description": "Remove an order from the database.",
        "operationId": "deleteOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "Order ID to be deleted",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Order successfully deleted.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          },
          "500": {
            "description": "Error creating order"
          }
        }
      }
    },
    "/orders/list": {
      "get": {
        "summary": "List all orders",
        "description": "Returns a list of all registered orders.",
        "operationId": "listorders",
        "responses": {
          "200": {
            "description": "Orders list",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Pedido"
              }
            }
          },
          "500": {
            "description": "Error listing orders"
          }
        }
      }
    }
  },
  "definitions": {
    "PedidoInput": {
      "type": "object",
      "required": ["numeroPedido", "valorTotal", "dataCriacao", "items"],
      "properties": {
        "numeroPedido": {
          "type": "string",
          "example": "v10089015vdb-01",
          "description": "Unique order number"
        },
        "valorTotal": {
          "type": "number",
          "example": 10000,
          "description": "Total order value"
        },
        "dataCriacao": {
          "type": "string",
          "format": "date-time",
          "example": "2023-07-19T12:24:11.5299601+00:00",
          "description": "Date the order was created in ISO 8601 format."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemInput"
          },
          "description": "Order list"
        }
      }
    },
    "ItemInput": {
      "type": "object",
      "required": ["idItem", "quantidadeItem", "valorItem"],
      "properties": {
        "idItem": {
          "type": "string",
          "example": "2434",
          "description": "Product ID"
        },
        "quantidadeItem": {
          "type": "integer",
          "example": 1,
          "description": "Item quantity"
        },
        "valorItem": {
          "type": "number",
          "example": 1000,
          "description": "Unit price of the item"
        }
      }
    },
    "Pedido": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "description": "ID do MongoDB"
        },
        "orderId": {
          "type": "string",
          "example": "v10089015vdb-01",
          "description": "Unique order number"
        },
        "value": {
          "type": "number",
          "example": 10000,
          "description": "Total order value"
        },
        "creationDate": {
          "type": "string",
          "format": "date-time",
          "example": "2023-07-19T12:24:11.529Z",
          "description": "Order creation date"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Order list"
        }
      }
    },
    "Item": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "integer",
          "example": 2434,
          "description": "Product ID"
        },
        "quantity": {
          "type": "integer",
          "example": 1,
          "description": "Item quantity"
        },
        "price": {
          "type": "number",
          "example": 1000,
          "description": "Unit price of the item"
        }
      }
    }
  }
}

